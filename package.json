{
  "name": "@sunilaleti/hx",
  "version": "0.3.0-beta.1",
  "description": "HX - an agent harness for the terminal",
  "license": "MIT",
  "author": "Sunil Aleti",
  "homepage": "https://hx.sunilaleti.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aletisunil/hx.git"
  },
  "bugs": "https://github.com/aletisunil/hx/issues",
  "keywords": [
    "agent",
    "cli",
    "tui",
    "llm",
    "openrouter",
    "coding-agent"
  ],
  "type": "module",
  "bin": {
    "hx": "dist/hx.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && biome check . && node scripts/check-literals.mjs",
    "format": "biome format --write .",
    "e2e": "npm run build && HX_E2E_BIN=dist/hx.js HX_E2E_REPORT=e2e-report-ts uv run pytest $(cat tests/e2e/typescript.txt)",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "koffi": "3.3.2",
    "markdown-it": "14.3.2",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  }
}
