/* HX stylesheet.

   Colours come from the Textual theme built in hx.tui.theme, so light, dark
   and ansi all resolve through the same design tokens. Rich renderables read
   the same palette directly; nothing here hard-codes a colour.

   Layout: a scrolling transcript with an optional todo sidebar, over a fixed
   dock of subagent rows, working indicator, prompt and footer. The dock never
   scrolls away - a running turn should stay visible while the user reads back
   through old output. */

Screen {
    layers: base modal;
    background: $background;
    color: $foreground;
}

#body {
    height: 1fr;
}

Transcript {
    width: 1fr;
    height: 1fr;
    padding: 0 1 0 0;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

/* Vertical rhythm: every block gets air above it, so a tool call and the
   sentence that follows it do not read as one run-on line.

   The blank left border is a permanent one-cell gutter. It costs nothing while
   idle and means the keyboard cursor can light it up without every block on
   screen shifting a column sideways. */
Transcript > MessageBlock,
Transcript > ToolBlock,
Transcript > PermissionPrompt,
Transcript > Notice {
    height: auto;
    margin: 1 0 0 0;
    border-left: blank;
}

/* The block the keyboard is pointing at. */
Transcript > .cursored {
    border-left: vkey $primary;
    background: $selected-bg 25%;
}

/* Notices use the same gutter as the cursor, in the colour of what happened.
   An error and a routine "model switched" are the same shape otherwise, and
   the one that matters should be findable while scrolling past. */
Transcript > Notice.notice-error {
    border-left: vkey $error;
}

Transcript > Notice.notice-warning {
    border-left: vkey $warning;
}

Transcript > Notice.notice-success {
    border-left: vkey $success;
}

/* The user's own turn is the anchor of an exchange; it gets the strongest
   block treatment so the eye can find where each one starts. */
Transcript > MessageBlock.role-user {
    margin: 1 0 0 0;
}

Transcript > Notice {
    padding: 0 1;
}

/* A pending approval is the one block on screen that is waiting on the user, so
   it keeps the cursor gutter lit for as long as it is unanswered. Once it
   collapses into its record line it gives the gutter back and reads as the
   notice it has become. */
Transcript > PermissionPrompt.permission-prompt {
    border-left: vkey $warning;
}

Transcript > PermissionPrompt:focus {
    /* Focus moved here for the duration of the question; the block already
       announces itself, so this must not add a second highlight fighting it. */
    background: transparent;
}

TodoSidebar {
    width: 34;
    height: 1fr;
    display: none;
    padding: 0 1;
    border-left: solid $panel;
}

TodoSidebar.visible {
    display: block;
}

SubagentRows {
    height: auto;
    max-height: 6;
    padding: 0 1;
}

/* The prompt, framed by two rules. The top one carries the working status, so
   a turn starting costs no layout: the row is there either way. */
#prompt-frame {
    height: auto;
    background: $surface;
}

WorkingIndicator,
#prompt-rule-bottom {
    height: 1;
    width: 1fr;
    background: $surface;
}

PromptInput {
    height: auto;
    min-height: 1;
    max-height: 12;
    padding: 0 1;
    border: none;
    background: $surface;
}

/* Completion popup, directly above the frame it completes into. */
#autocomplete {
    height: auto;
    max-height: 10;
    padding: 0 1;
    background: $surface;
}

/* One dim line of shortcuts. Never grows, never scrolls. */
#hints {
    height: 1;
    padding: 0 1;
    background: $background;
}

.startup-header {
    height: auto;
    padding: 0 1;
    margin: 0;
}

StatusBar {
    height: 2;
    dock: bottom;
    padding: 0 1;
    background: $background;
}

ModalScreen {
    layer: modal;
    align: center middle;
    /* Dim the transcript rather than erasing it: the user should still see what
       they were doing when the prompt appeared. */
    background: $background 60%;
}

#picker {
    width: 90%;
    max-width: 120;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#picker-title {
    text-style: bold;
    color: $primary;
    padding: 0;
}

/* The filter box is a line to type on, not a widget to look at. Textual's
   default tall Input border fights the panel's own frame; a single rule under
   it separates the query from the results and nothing else. */
#picker-filter {
    border: none;
    padding: 0;
    height: 1;
    background: $surface;
}

#picker-rule {
    height: 1;
    color: $secondary;
    background: $surface;
}

#picker-options {
    height: auto;
    max-height: 20;
    border: none;
    background: $surface;
}

/* Configuration modal, sized to its content. */
#configure {
    width: 80%;
    max-width: 90;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#configure-summary {
    height: auto;
    padding: 1 0;
}

#configure-warning {
    height: auto;
    padding: 0 0 1 0;
}

#configure-key {
    height: auto;
    padding: 0 0 1 0;
}

#configure-actions {
    height: auto;
    padding: 1 0 0 0;
    align-horizontal: right;
}

#configure-actions Button {
    margin: 0 0 0 1;
    min-width: 12;
}
