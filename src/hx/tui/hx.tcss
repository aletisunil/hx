/* HX stylesheet.

   Colours come from the Textual theme built in hx.tui.theme, so light, dark
   and ansi all resolve through the same design tokens. Rich renderables read
   the same palette directly; nothing here hard-codes a colour.

   Layout: a scrolling transcript with an optional todo sidebar, over a fixed
   dock of subagent rows, working indicator, prompt and footer. The dock never
   scrolls away - a running turn should stay visible while the user reads back
   through old output. */

Screen {
    layers: base modal;
    background: $background;
    color: $foreground;
}

#body {
    height: 1fr;
}

Transcript {
    width: 1fr;
    height: 1fr;
    padding: 0 1 0 0;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

/* Vertical rhythm: every block gets air above it, so a tool call and the
   sentence that follows it do not read as one run-on line. */
Transcript > MessageBlock,
Transcript > ToolBlock,
Transcript > Notice {
    height: auto;
    margin: 1 0 0 0;
}

/* The user's own turn is the anchor of an exchange; it gets the strongest
   block treatment so the eye can find where each one starts. */
Transcript > MessageBlock.role-user {
    margin: 1 0 0 0;
}

Transcript > Notice {
    padding: 0 1;
}

TodoSidebar {
    width: 34;
    height: 1fr;
    display: none;
    padding: 0 1;
    border-left: solid $panel;
}

TodoSidebar.visible {
    display: block;
}

SubagentRows {
    height: auto;
    max-height: 6;
    padding: 0 1;
}

/* Zero height while idle so the prompt sits flush against the transcript. */
WorkingIndicator {
    height: 0;
    padding: 0 1;
}

WorkingIndicator.busy {
    height: 1;
}

PromptInput {
    height: auto;
    min-height: 3;
    max-height: 12;
    padding: 0 1;
    border: round $panel;
    background: $surface;
}

PromptInput:focus {
    border: round $primary;
}

StatusBar {
    height: 2;
    dock: bottom;
    padding: 0 1;
    background: $background;
}

ModalScreen {
    layer: modal;
    align: center middle;
    /* Dim the transcript rather than erasing it: the user should still see what
       they were doing when the prompt appeared. */
    background: $background 60%;
}

#picker {
    width: 90%;
    max-width: 120;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#picker-title {
    text-style: bold;
    color: $primary;
    padding: 0 0 1 0;
}

#picker-options {
    height: auto;
    max-height: 20;
    border: none;
    background: $surface;
}

/* Permission prompt. Sized to its content so the buttons sit under the diff,
   not stranded at the bottom of an empty screen. */
#permission {
    width: 90%;
    max-width: 110;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#permission-title {
    padding: 0 0 1 0;
}

#permission-detail {
    height: auto;
    max-height: 20;
    padding: 0 1;
    border: round $panel;
    background: $panel;
}

#permission-actions {
    height: auto;
    padding: 1 0 0 0;
    align-horizontal: right;
}

#permission-actions Button {
    margin: 0 0 0 1;
    min-width: 14;
}

/* Configuration modal. Sized to content, like the permission prompt. */
#configure {
    width: 80%;
    max-width: 90;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#configure-summary {
    height: auto;
    padding: 1 0;
}

#configure-warning {
    height: auto;
    padding: 0 0 1 0;
}

#configure-key {
    height: auto;
    padding: 0 0 1 0;
}

#configure-actions {
    height: auto;
    padding: 1 0 0 0;
    align-horizontal: right;
}

#configure-actions Button {
    margin: 0 0 0 1;
    min-width: 12;
}
